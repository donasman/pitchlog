spring:
  datasource:
    url: jdbc:postgresql://localhost:5433/pitchlog
    username: pitchlog
    password: pitchlog

  jpa:
    hibernate:
      ddl-auto: update   # create-drop → update: 재시작해도 데이터 유지
    show-sql: true

cors:
  allowed-origins: http://localhost:3000,http://localhost:3001

api-football:
  api-key: ${API_FOOTBALL_KEY:}  # IntelliJ 환경변수에 API_FOOTBALL_KEY=발급받은키 추가
  wc-league-id: 1                # FIFA World Cup league ID (API-Football)
  season: 2022                   # 로컬 검증용: 2022(카타르WC, Free 플랜 가능) | 프로덕션: 2026
  scheduler-enabled: false       # 로컬에서 자동 스케줄러 비활성화
  squad-max-pages: 1             # 로컬 테스트: 팀당 1페이지(20명)만 수집 | 프로덕션: -1(전체)
  player-stats-season: 2021      # 2022 WC 선수 통계 시즌 (WC 직전 클럽 시즌)
  player-stats-limit: 10         # 로컬 테스트: 10명만 수집 (Free 플랜 100콜/일 대응)

# 관리자 인증 토큰 (비워두면 인증 없이 통과 — 개발 편의)
# 운영 배포 시 admin.token: 복잡한값 으로 설정
admin:
  token: ""

logging:
  level:
    com.pitchlog: DEBUG
    org.hibernate.SQL: DEBUG
